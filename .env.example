# AgentTeams Controller endpoint (used by server-side proxy)
AGENTTEAMS_CONTROLLER_URL=http://127.0.0.1:8090

# Higress external adapter. `direct` preserves the current direct-model flow.
# Set `external` only when the deployment provides a Higress Gateway endpoint.
AGENTTEAMS_HIGRESS_ADAPTER_MODE=direct
# AGENTTEAMS_AI_GATEWAY_URL=https://higress-gateway.example.com

# Optional Higress Console endpoint for shared authentication and model management.
# AGENTTEAMS_AI_GATEWAY_ADMIN_URL=https://higress-console.example.com
# Comma-separated exact hostnames allowed for the Console server-side proxy.
# AGENTTEAMS_AI_GATEWAY_ADMIN_ALLOWED_HOSTS=higress-console.example.com

# Optional: base URL of a local SGLang inference server (OpenAI-compatible),
# e.g. http://192.168.1.10:8000. When set, model selectors offer the models
# SGLang currently serves (a "SGLang" source layer) next to the alias layer.
# Leave empty when the deployment has no local SGLang — the layer stays off.
# AGENTTEAMS_SGLANG_URL=http://192.168.1.10:8000

# Optional: browser-facing controller URL default (can be overridden in UI)
NEXT_PUBLIC_AGENTTEAMS_CONTROLLER_URL=http://127.0.0.1:8090

# Authentication to AgentTeams Controller.
# Prefer AGENTTEAMS_AUTH_TOKEN_FILE for rotated ServiceAccount tokens.
# NOTE: the controller writes the CLI token to /var/run/agentteams/cli-token.
# AGENTTEAMS_AUTH_TOKEN=
AGENTTEAMS_AUTH_TOKEN_FILE=/var/run/agentteams/cli-token

# Escape hatch: disable the browser-session gate on /api/agentteams/*.
# Only for local dev / hosted previews; production must keep it unset so the
# gate stays on. (M19: the gate is now the dashboard session, not the
# Higress Console probe.) While disabled, middleware injects the synthetic
# identity below so server-side RBAC evaluation and audit read/write
# attribution keep working.
# AGENTTEAMS_AUTH_DISABLED=true
# AGENTTEAMS_LOCAL_USER=local-admin
# AGENTTEAMS_LOCAL_USER_LEVEL=3

# SEC-10: honor x-forwarded-for for audit source_ip ONLY when the dashboard
# sits behind a trusted reverse proxy that sets it. Unset/false (default) =
# audit events record no client IP, so callers cannot forge attribution.
# AGENTTEAMS_TRUST_PROXY=true

# --- Multi-user login (M19) ---
# REQUIRED for login: the HMAC secret for the dashboard session cookie.
# Generate once and keep it stable across container rebuilds:
#   openssl rand -hex 32
# If missing/short, login fails closed (no session can be created).
DASHBOARD_SESSION_SECRET=

# Set to 1 when the dashboard is served over HTTPS (adds the Secure cookie
# flag). Leave unset for LAN HTTP deployments.
# DASHBOARD_COOKIE_SECURE=1

# Matrix homeserver URL default (can be overridden in UI).
# In the embedded topology the dashboard container reaches Tuwunel at
# http://agentteams-controller:6167; the value below is for local dev on the host.
NEXT_PUBLIC_MATRIX_API_URL=http://agentteams-controller:6167

# Matrix homeserver whitelist for the proxy (comma-separated hostnames).
# Enforced for all token-forwarding Matrix routes (/api/matrix/*): when unset,
# a built-in default list applies (localhost, 127.0.0.1, ::1,
# agentteams-controller, matrix-local.agentteams.io, matrix.org,
# client.matrix.org). Any custom homeserver the Dashboard should be able to
# talk to (login sends raw credentials; sync/send/media forward the user's
# access token) must be listed here.
MATRIX_HOMESERVER_ALLOWLIST=agentteams-controller,matrix-local.agentteams.io,matrix.org

# Model provider connectivity probe (Settings → Models).
# User-supplied Base URLs are rejected when they point at loopback/private/
# cluster-internal hosts. Allow specific hosts or opt into LAN probing here.
# MODEL_PROBE_ALLOW_HOSTS=192.168.1.10,my-gpu-box.local
# MODEL_PROBE_ALLOW_PRIVATE_NETWORK=0

# Base path when embedded as a sub-application in AgentTeams.
# Leave empty for standalone root deployment.
NEXT_PUBLIC_BASE_PATH=/dashboard

# Optional: force deployment mode for menu filtering.
# When unset, mode is auto-detected from Controller API or K8s serviceaccount.
# The upstream AGENTTEAMS_KUBE_MODE=embedded|incluster convention is honored too.
# AGENTTEAMS_DEPLOYMENT_MODE=embedded

# MinIO Object Storage (used by Storage section in embedded mode)
# AGENTTEAMS_FS_ENDPOINT=http://agentteams-controller:9000
# AGENTTEAMS_FS_ACCESS_KEY=minioadmin
# AGENTTEAMS_FS_SECRET_KEY=minioadmin
# AGENTTEAMS_FS_BUCKET=agentteams-data
# AGENTTEAMS_FS_REGION=us-east-1

# Admin credentials for the Higress ensure-ai bootstrap (optional;
# auto-detected from the controller container by the install scripts)
# AGENTTEAMS_ADMIN_USER=admin
# AGENTTEAMS_ADMIN_PASSWORD=

# LLM API Key for AI Troubleshooting (optional)
# AGENTTEAMS_LLM_API_KEY=sk-...
# AGENTTEAMS_DEFAULT_MODEL=gpt-4

# --- First-launch backend setup (F1) -------------------------------------
# Standalone docker installs can skip all AGENTTEAMS_*_URL env vars: the
# first-launch setup page (shown instead of the login form) writes a
# dual-address config file that the dashboard prefers over env.
# Config file location (a mounted volume is strongly recommended so the
# config survives container rebuilds):
# DASHBOARD_CONFIG_FILE=/data/agentteams-dashboard/config.json
# One-time token for the pre-login setup write. Unset = auto-generated on
# first need, persisted next to the config file, and printed once to the
# server log ("one-time backend setup token"). In shared mode this env is
# the ONLY token source (never persisted). Ignored when the gate is
# disabled via DASHBOARD_SETUP_TOKEN_ENFORCE=0 below.
# DASHBOARD_SETUP_TOKEN=
# Optional SSRF filter for the setup "test connection" probe (comma-
# separated hosts). The probe is NO LONGER unauthenticated (PR-91 review):
# pre-login callers must hold the setup token (same door as the config
# write), post-login callers hold a session. Empty = allow for those
# session/token holders (local self-config posture; with
# DASHBOARD_SETUP_TOKEN_ENFORCE=0 this also covers logged-out
# trusted-LAN callers). Set it for a strict allowlist. The cloud metadata
# sentinel (169.254.169.254) is denied in all modes.
# DASHBOARD_ALLOWED_HOSTS=
# Shared (multi-user) deployment — F1f. Set 1 when MULTIPLE humans share
# this instance (e.g. admin L1 + team L2 on one container, as on a shared single-container deployment).
# Effects: (A) only admin (L1) sessions may save the backend config;
# (B) the setup token comes ONLY from DASHBOARD_SETUP_TOKEN env and is
# never generated/persisted to the volume (with no env token the pre-login
# setup path stays closed — set it so the ?setup=1 escape hatch works);
# (C) every config write is audited with actor + level + changed fields;
# (D) startup warns if AGENTTEAMS_AUTH_TOKEN is set — shared deployments
# should drop it (cluster super credential) and use the per-login
# controller-token paste. Leave unset for one-instance-per-user.
# DASHBOARD_SHARED_MODE=1
# Installer opt-out of the pre-login setup token gate — F1f3. Set 0 to
# make the pre-login (first-launch / ?setup=1) config save PLAIN: no
# token required, no token generated/printed/persisted, and the setup
# page hides the token field. The installer (deployer) makes this choice
# at docker-run time. WARNING: while disabled, anyone who can reach the
# dashboard can rewrite ALL backend addresses (redirects every user's
# data plane) — trusted-LAN deployments only; the startup log records
# the open state. Unset or 1 = gate enforced (default, F1e/F1f behavior).
# DASHBOARD_SETUP_TOKEN_ENFORCE=0
# Note: custom Matrix homeserver hosts also need MATRIX_HOMESERVER_ALLOWLIST
# (L2 login forwards the user's token to the host; private IPs are rejected
# unless explicitly allowed).

# Optional initial paid speech configuration. Settings > Backends > Speech
# saves a server-side speech.json beside DASHBOARD_CONFIG_FILE and overrides env.
# Keep the API key on the server; users explicitly select 百炼 in the mic menu.
# DASHBOARD_SPEECH_DASHSCOPE_API_KEY=
# DASHBOARD_SPEECH_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHBOARD_SPEECH_DASHSCOPE_MODEL=qwen3-asr-flash
# Build-time model mirror (also available as a Docker build arg).
# Must expose the pinned Whisper files listed in scripts/prepare-speech-assets.mjs.
# SPEECH_MODEL_DOWNLOAD_BASE_URL=https://your-mirror/onnx-community/whisper-tiny/resolve/ff41770

# Optional Worker tracing defaults. The admin UI (Console > Governance >
# Tracing > 可观测配置) writes observability.json beside DASHBOARD_CONFIG_FILE
# (mode 0600) and overrides these env values. They exist so an existing
# Langfuse project can be queried before the UI is ever opened. Worker
# telemetry env is applied per Worker through the Controller API, and the
# project query secret stays on the Dashboard server — never on Workers.
# LANGFUSE_BASE_URL=https://langfuse.example.com
# LANGFUSE_PUBLIC_URL=https://langfuse.example.com
# LANGFUSE_PROJECT_ID=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=

# Isolated tracing demo page (/tracing-demo). Requires a synthetic identity
# and an explicit scope because there is no Controller to query. Leave unset
# in real deployments; the page itself 404s unless TRACING_DEMO=true.
# AGENTTEAMS_TRACING_DEMO=true
# AGENTTEAMS_TRACING_DEMO_SCOPE={"teams":[],"workers":[]}
