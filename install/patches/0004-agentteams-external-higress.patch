+
+func TestWorkerEnvBuilderPreservesExternalGatewayAndModelAlias(t *testing.T) {
+	builder := NewWorkerEnvBuilder(config.WorkerEnvDefaults{
+		AIGatewayURL: "https://gateway.example.test",
+		Runtime:      "docker",
+	})
+
+	workerEnv := builder.Build("worker", &WorkerProvisionResult{})
+	if got, want := workerEnv["AGENTTEAMS_AI_GATEWAY_URL"], "https://gateway.example.test"; got != want {
+		t.Fatalf("worker gateway URL = %q, want %q", got, want)
+	}
+
+	managerEnv := builder.BuildManager("manager", &ManagerProvisionResult{}, v1beta1.ManagerSpec{
+		Model: "team-default",
+	})
+	for key, want := range map[string]string{
+		"AGENTTEAMS_AI_GATEWAY_URL": "https://gateway.example.test",
+		"AGENTTEAMS_DEFAULT_MODEL":  "team-default",
+	} {
+		if got := managerEnv[key]; got != want {
+			t.Fatalf("manager %s = %q, want %q", key, got, want)
+		}
+	}
+}
