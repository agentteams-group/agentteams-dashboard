  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-document-preview-assets.mjs && npm run prepare:speech",
    "dev": "node scripts/dev.mjs",
    "prepare:speech": "node scripts/prepare-speech-assets.mjs",
    "prepare:pptx-fonts": "node scripts/prepare-pptx-font-assets.mjs",
    "build": "npm run prepare:speech && next build && node scripts/copy-standalone-assets.mjs",
    "start": "node scripts/start.mjs",
    "lint": "eslint . && node scripts/typography-scan.mjs",
    "lint:tone": "node scripts/ai-tone-scan.mjs",
    "lint:typography": "node scripts/typography-scan.mjs",
    "typecheck": "tsc --noEmit",
    "check:bundle": "node scripts/check-quality-gates.mjs bundle",
    "check:lines": "node scripts/check-quality-gates.mjs lines",
    "check:quality": "npm run check:bundle && npm run check:lines",
    "check:assets": "node scripts/check-assets.mjs",
    "test:quality": "node --test scripts/test-quality-gates.mjs scripts/test-approved-plan-commands.mjs",
    "test:dependencies": "node --test scripts/test-stream-json-compat.mjs",
    "test:perf": "node scripts/run-performance-checks.mjs",
    "test:e2e": "node scripts/smoke-e2e.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "build:quality": "node scripts/copy-document-preview-assets.mjs && next build",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:model-skill": "vitest run --config vitest.integration-model-skill.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "prebuild": "node scripts/copy-document-preview-assets.mjs"
  },
